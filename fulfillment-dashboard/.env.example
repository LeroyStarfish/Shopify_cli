# Copy this file to .env and fill in the values.
# Get these from your Shopify Partner Dashboard app settings.

SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""

# Scopes the app requests on install
SCOPES="read_orders,read_fulfillments,read_shipping,write_fulfillments"

# ── Shippo webhook bridge ────────────────────────────────────────────────────
# Secret used to verify the HMAC-SHA256 signature on incoming Shippo webhooks.
# To get this value: contact Shippo support and request HMAC webhook signing.
# They will provide the secret after a brief setup (allow up to 10 business days).
# Without this set the handler will still accept webhooks but will log a warning.
SHIPPO_WEBHOOK_SECRET=""

# SQLite for local dev.  For Vercel production, use a PostgreSQL URL:
#   DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"
